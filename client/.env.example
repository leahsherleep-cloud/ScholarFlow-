# ScholarFlow Frontend Environment Configuration
# For local development with Vite dev server proxy to port 5000:
# Leave VITE_API_URL commented out or empty.
# VITE_API_URL=http://localhost:5000

# For production deployment on Vercel:
# Set to your deployed Render backend URL (no trailing slash, without /api suffix)
# VITE_API_URL=https://scholarflow-api-2yas.onrender.com
